							"mode": "raw",
							"raw": "[\n    {\n        \"person_id\": \"uuid-1\",\n        \"property_id\": \"uuid-2\"\n    },\n    {\n        \"person_id\": \"uuid-3\",\n        \"property_id\": \"uuid-4\"\n    }\n]"
