{
	"info": {
		"_postman_id": "jbpm-workflow-collection",
		"name": "jbpm-workflow-collection",
		"description": "Postman collection for the jBPM Workflow Engine API.\n\nBase URL: http://localhost:8006\nAuthentication: Bearer Token (Keycloak OAuth2)\n\nRealm: property-management-platform\nClient: property-platform-backend-services\nToken URL: http://localhost:8080/realms/property-management-platform/protocol/openid-connect/token",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{access_token}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-fetch Keycloak token before each request",
					"const tokenUrl = pm.variables.get('keycloak_url') + '/realms/' + pm.variables.get('realm') + '/protocol/openid-connect/token';",
					"",
					"pm.sendRequest({",
					"    url: tokenUrl,",
					"    method: 'POST',",
					"    header: { 'Content-Type': 'application/x-www-form-urlencoded' },",
					"    body: {",
					"        mode: 'urlencoded',",
					"        urlencoded: [",
					"            { key: 'grant_type', value: 'client_credentials' },",
					"            { key: 'client_id', value: pm.variables.get('client_id') },",
					"            { key: 'client_secret', value: pm.variables.get('client_secret') }",
					"        ]",
					"    }",
					"}, function (err, res) {",
					"    if (!err && res.code === 200) {",
					"        pm.variables.set('access_token', res.json().access_token);",
					"    }",
					"});"
				]
			}
		}
	],
