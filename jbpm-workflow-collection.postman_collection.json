							"raw": "{{base_url}}/api/v1/processes/{{process_id}}/start",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "processes", "{{process_id}}", "start"]
						},
						"description": "Start a new process instance for the given process definition. Variables in the body are passed as process variables."
					}
				},
