    <bpmn2:sequenceFlow id="Flow_1ujy52s" sourceRef="Activity_1hi76tw" targetRef="Gateway_0lawyer_check" />
    <bpmn2:sequenceFlow id="Flow_1vlznos" name="yes" sourceRef="Gateway_0lawyer_check" targetRef="Gateway_conv_0jqstsy">
