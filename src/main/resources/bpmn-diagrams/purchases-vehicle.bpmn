    <bpmn2:sequenceFlow id="Flow_lawyer_exists" sourceRef="Gateway_0lawyer_check" targetRef="Gateway_conv_0jqstsy">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">return is_lawyer_exists == true;</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_no_lawyer" sourceRef="Gateway_0lawyer_check" targetRef="Gateway_04vfalz">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">return is_lawyer_exists == false;</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_0qqnq5y" sourceRef="StartEvent_1" targetRef="Activity_1bszshg" />
    <bpmn2:sequenceFlow id="Flow_1inrkvq" sourceRef="Activity_1bszshg" targetRef="Activity_0espi6m" />
    <bpmn2:sequenceFlow id="Flow_084j2tc" sourceRef="Activity_0espi6m" targetRef="Gateway_1q8kvjx" />
    <bpmn2:sequenceFlow id="Flow_1nm8tvm" name="vehicle not valid OR buyer not interested" sourceRef="Gateway_1q8kvjx" targetRef="Event_0iogr00_alt">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">return vehicle_validity == false || buyer_interested == false;</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_0kthh38" name="vehicle validity AND buyer still interested" sourceRef="Gateway_1q8kvjx" targetRef="Activity_0ycxl8n">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">return vehicle_validity == true &amp;&amp; buyer_interested == true;</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_1u1ts3e" sourceRef="Activity_0tb274o" targetRef="Event_0iogr00" />
