        <bpmn2:targetRef>mobile_number</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:userTask>
    <bpmn2:task id="Activity_15839ek" name="Notify admins" drools:taskName="notify-admins">
      <bpmn2:incoming>Flow_1wtn7yy</bpmn2:incoming>
      <bpmn2:outgoing>Flow_1q8z95v</bpmn2:outgoing>
      <bpmn2:ioSpecification id="ioSpec_Activity_15839ek">
        <bpmn2:dataInput id="_Activity_15839ek_TaskTypeInput" drools:dtype="String" name="TaskType" />
        <bpmn2:dataInput id="_Activity_15839ek_bodyInput" drools:dtype="String" name="body" />
        <bpmn2:dataInput id="_Activity_15839ek_subjectInput" drools:dtype="String" name="subject" />
        <bpmn2:inputSet id="inputSet_Activity_15839ek">
          <bpmn2:dataInputRefs>_Activity_15839ek_TaskTypeInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Activity_15839ek_bodyInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Activity_15839ek_subjectInput</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="outputSet_Activity_15839ek">
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation id="dia_Activity_15839ek_TaskType">
        <bpmn2:targetRef>_Activity_15839ek_TaskTypeInput</bpmn2:targetRef>
        <bpmn2:assignment id="assign_Activity_15839ek_TaskType">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">notify-admins</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_Activity_15839ek_TaskTypeInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia_Activity_15839ek_body">
        <bpmn2:targetRef>_Activity_15839ek_bodyInput</bpmn2:targetRef>
        <bpmn2:assignment id="assign_Activity_15839ek_body">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">#{"Just notifying you that a new user:" + first_name +" " + last_name +" has signed up to use the Property Platform"}</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_Activity_15839ek_bodyInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia_Activity_15839ek_subject">
        <bpmn2:targetRef>_Activity_15839ek_subjectInput</bpmn2:targetRef>
        <bpmn2:assignment id="assign_Activity_15839ek_subject">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">New User Sign-up (Property Platform)</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_Activity_15839ek_subjectInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
    </bpmn2:task>
    <bpmn2:task id="Activity_1ti0w73" name="Send welcome message to user" drools:taskName="send-user-message">
      <bpmn2:incoming>Flow_1hc7vnt</bpmn2:incoming>
      <bpmn2:outgoing>Flow_12o08yi</bpmn2:outgoing>
      <bpmn2:ioSpecification id="ioSpec_Activity_1ti0w73">
        <bpmn2:dataInput id="_Activity_1ti0w73_TaskTypeInput" drools:dtype="String" name="TaskType" />
        <bpmn2:dataInput id="_Activity_1ti0w73_subjectInput" drools:dtype="String" name="subject" />
        <bpmn2:dataInput id="_Activity_1ti0w73_bodyInput" drools:dtype="String" name="body" />
        <bpmn2:dataInput id="_Activity_1ti0w73_messageInput" drools:dtype="String" name="message" />
        <bpmn2:inputSet id="inputSet_Activity_1ti0w73">
          <bpmn2:dataInputRefs>_Activity_1ti0w73_TaskTypeInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Activity_1ti0w73_subjectInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Activity_1ti0w73_bodyInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Activity_1ti0w73_messageInput</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="outputSet_Activity_1ti0w73">
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation id="dia_Activity_1ti0w73_TaskType">
        <bpmn2:targetRef>_Activity_1ti0w73_TaskTypeInput</bpmn2:targetRef>
        <bpmn2:assignment id="assign_Activity_1ti0w73_TaskType">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">send-user-message</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_Activity_1ti0w73_TaskTypeInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia_Activity_1ti0w73_subject">
        <bpmn2:targetRef>_Activity_1ti0w73_subjectInput</bpmn2:targetRef>
        <bpmn2:assignment id="assign_Activity_1ti0w73_subject">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">Welcome to our Property Platform</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_Activity_1ti0w73_subjectInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia_Activity_1ti0w73_body">
        <bpmn2:targetRef>_Activity_1ti0w73_bodyInput</bpmn2:targetRef>
        <bpmn2:assignment id="assign_Activity_1ti0w73_body">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">Welcome to our Property Platform where you will be able to list, buy or sell your properties.  Your next step would be to verify your identity, as our first priority is to protect buyers, sellers and other parties who use this platform.</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_Activity_1ti0w73_bodyInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia_Activity_1ti0w73_message">
        <bpmn2:targetRef>_Activity_1ti0w73_messageInput</bpmn2:targetRef>
        <bpmn2:assignment id="assign_Activity_1ti0w73_message">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">Next steps: Identify Verification</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_Activity_1ti0w73_messageInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
    </bpmn2:task>
