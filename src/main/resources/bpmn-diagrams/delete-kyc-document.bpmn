<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:drools="http://www.jboss.org/drools"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_0bkn459"
                   targetNamespace="http://www.jboss.org/drools"
                   expressionLanguage="http://www.mvel.org/2.0"
                   typeLanguage="http://www.java.com/javaTypes"
                   xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd">

  <!-- ============ Item Definitions (process variables) ============ -->
  <bpmn2:itemDefinition id="_bodyItem" structureRef="String" />
  <bpmn2:itemDefinition id="_device_tokenItem" structureRef="String" />
  <bpmn2:itemDefinition id="_document_idItem" structureRef="String" />
  <bpmn2:itemDefinition id="_document_typeItem" structureRef="String" />
  <bpmn2:itemDefinition id="_emailItem" structureRef="String" />
  <bpmn2:itemDefinition id="_first_nameItem" structureRef="String" />
  <bpmn2:itemDefinition id="_last_nameItem" structureRef="String" />
  <bpmn2:itemDefinition id="_messageItem" structureRef="String" />
  <bpmn2:itemDefinition id="_mobile_numberItem" structureRef="String" />
  <bpmn2:itemDefinition id="_person_idItem" structureRef="String" />
  <bpmn2:itemDefinition id="_subjectItem" structureRef="String" />

  <!-- ============ Process ============ -->
  <bpmn2:process id="delete-kyc-document" name="delete-kyc-document" isExecutable="true"
                 drools:packageName="com.greysoft.jbpm_engine.processes">

    <!-- Process-level variables -->
    <bpmn2:property id="body" itemSubjectRef="_bodyItem" name="body" />
    <bpmn2:property id="device_token" itemSubjectRef="_device_tokenItem" name="device_token" />
    <bpmn2:property id="document_id" itemSubjectRef="_document_idItem" name="document_id" />
    <bpmn2:property id="document_type" itemSubjectRef="_document_typeItem" name="document_type" />
    <bpmn2:property id="email" itemSubjectRef="_emailItem" name="email" />
    <bpmn2:property id="first_name" itemSubjectRef="_first_nameItem" name="first_name" />
    <bpmn2:property id="last_name" itemSubjectRef="_last_nameItem" name="last_name" />
    <bpmn2:property id="message" itemSubjectRef="_messageItem" name="message" />
    <bpmn2:property id="mobile_number" itemSubjectRef="_mobile_numberItem" name="mobile_number" />
    <bpmn2:property id="person_id" itemSubjectRef="_person_idItem" name="person_id" />
    <bpmn2:property id="subject" itemSubjectRef="_subjectItem" name="subject" />

    <bpmn2:startEvent id="StartEvent_1">
      <bpmn2:outgoing>Flow_1rjds41</bpmn2:outgoing>
    </bpmn2:startEvent>

    <bpmn2:userTask id="Activity_0qxttjd" name="Submit document to be deleted">
      <bpmn2:incoming>Flow_1rjds41</bpmn2:incoming>
      <bpmn2:outgoing>Flow_0luoemx</bpmn2:outgoing>
      <bpmn2:ioSpecification id="ioSpec_Activity_0qxttjd">
        <bpmn2:dataOutput id="_Activity_0qxttjd_person_idOutput" name="person_id" />
        <bpmn2:dataOutput id="_Activity_0qxttjd_document_idOutput" name="document_id" />
        <bpmn2:dataOutput id="_Activity_0qxttjd_document_typeOutput" name="document_type" />
        <bpmn2:dataOutput id="_Activity_0qxttjd_first_nameOutput" name="first_name" />
        <bpmn2:dataOutput id="_Activity_0qxttjd_last_nameOutput" name="last_name" />
        <bpmn2:dataOutput id="_Activity_0qxttjd_mobile_numberOutput" name="mobile_number" />
        <bpmn2:dataOutput id="_Activity_0qxttjd_device_tokenOutput" name="device_token" />
        <bpmn2:dataOutput id="_Activity_0qxttjd_emailOutput" name="email" />
        <bpmn2:inputSet id="inputSet_Activity_0qxttjd" />
        <bpmn2:outputSet id="outputSet_Activity_0qxttjd">
          <bpmn2:dataOutputRefs>_Activity_0qxttjd_person_idOutput</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_Activity_0qxttjd_document_idOutput</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_Activity_0qxttjd_document_typeOutput</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_Activity_0qxttjd_first_nameOutput</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_Activity_0qxttjd_last_nameOutput</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_Activity_0qxttjd_mobile_numberOutput</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_Activity_0qxttjd_device_tokenOutput</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_Activity_0qxttjd_emailOutput</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataOutputAssociation id="doa_Activity_0qxttjd_person_id">
        <bpmn2:sourceRef>_Activity_0qxttjd_person_idOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>person_id</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation id="doa_Activity_0qxttjd_document_id">
        <bpmn2:sourceRef>_Activity_0qxttjd_document_idOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>document_id</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation id="doa_Activity_0qxttjd_document_type">
        <bpmn2:sourceRef>_Activity_0qxttjd_document_typeOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>document_type</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation id="doa_Activity_0qxttjd_first_name">
        <bpmn2:sourceRef>_Activity_0qxttjd_first_nameOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>first_name</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation id="doa_Activity_0qxttjd_last_name">
        <bpmn2:sourceRef>_Activity_0qxttjd_last_nameOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>last_name</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation id="doa_Activity_0qxttjd_mobile_number">
        <bpmn2:sourceRef>_Activity_0qxttjd_mobile_numberOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>mobile_number</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation id="doa_Activity_0qxttjd_device_token">
        <bpmn2:sourceRef>_Activity_0qxttjd_device_tokenOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>device_token</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation id="doa_Activity_0qxttjd_email">
        <bpmn2:sourceRef>_Activity_0qxttjd_emailOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>email</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:userTask>

    <bpmn2:task id="Activity_1pcujrf" name="Update Kyc"
               drools:taskName="delete-kyc-data">
      <bpmn2:incoming>Flow_0luoemx</bpmn2:incoming>
      <bpmn2:outgoing>Flow_1vsk09w</bpmn2:outgoing>
      <bpmn2:ioSpecification id="ioSpec_Activity_1pcujrf">
        <bpmn2:dataInput id="_Activity_1pcujrf_TaskTypeInput" drools:dtype="String" name="TaskType" />
        <bpmn2:dataInput id="_Activity_1pcujrf_document_typeInput" drools:dtype="String" name="document_type" />
        <bpmn2:dataInput id="_Activity_1pcujrf_person_idInput" drools:dtype="String" name="person_id" />
        <bpmn2:dataInput id="_Activity_1pcujrf_document_idInput" drools:dtype="String" name="document_id" />
        <bpmn2:inputSet id="inputSet_Activity_1pcujrf">
          <bpmn2:dataInputRefs>_Activity_1pcujrf_TaskTypeInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Activity_1pcujrf_document_typeInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Activity_1pcujrf_person_idInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Activity_1pcujrf_document_idInput</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="outputSet_Activity_1pcujrf">
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation id="dia_Activity_1pcujrf_TaskType">
        <bpmn2:targetRef>_Activity_1pcujrf_TaskTypeInput</bpmn2:targetRef>
        <bpmn2:assignment id="assign_Activity_1pcujrf_TaskType">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">delete-kyc-data</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_Activity_1pcujrf_TaskTypeInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia_Activity_1pcujrf_document_type">
        <bpmn2:sourceRef>document_type</bpmn2:sourceRef>
        <bpmn2:targetRef>_Activity_1pcujrf_document_typeInput</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia_Activity_1pcujrf_person_id">
        <bpmn2:sourceRef>person_id</bpmn2:sourceRef>
        <bpmn2:targetRef>_Activity_1pcujrf_person_idInput</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia_Activity_1pcujrf_document_id">
        <bpmn2:sourceRef>document_id</bpmn2:sourceRef>
        <bpmn2:targetRef>_Activity_1pcujrf_document_idInput</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
    </bpmn2:task>

    <bpmn2:task id="Activity_11jd6d5" name="Delete document"
               drools:taskName="delete-document">
      <bpmn2:incoming>Flow_1vsk09w</bpmn2:incoming>
      <bpmn2:outgoing>Flow_0whyk7g</bpmn2:outgoing>
      <bpmn2:ioSpecification id="ioSpec_Activity_11jd6d5">
        <bpmn2:dataInput id="_Activity_11jd6d5_TaskTypeInput" drools:dtype="String" name="TaskType" />
        <bpmn2:dataInput id="_Activity_11jd6d5_document_idInput" drools:dtype="String" name="document_id" />
        <bpmn2:inputSet id="inputSet_Activity_11jd6d5">
          <bpmn2:dataInputRefs>_Activity_11jd6d5_TaskTypeInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Activity_11jd6d5_document_idInput</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="outputSet_Activity_11jd6d5">
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation id="dia_Activity_11jd6d5_TaskType">
        <bpmn2:targetRef>_Activity_11jd6d5_TaskTypeInput</bpmn2:targetRef>
        <bpmn2:assignment id="assign_Activity_11jd6d5_TaskType">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">delete-document</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_Activity_11jd6d5_TaskTypeInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia_Activity_11jd6d5_document_id">
        <bpmn2:sourceRef>document_id</bpmn2:sourceRef>
        <bpmn2:targetRef>_Activity_11jd6d5_document_idInput</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
    </bpmn2:task>

    <bpmn2:task id="Activity_03cwn8x" name="Send user verification success message"
               drools:taskName="send-user-message">
      <bpmn2:incoming>Flow_0whyk7g</bpmn2:incoming>
      <bpmn2:outgoing>Flow_1asrulk</bpmn2:outgoing>
      <bpmn2:ioSpecification id="ioSpec_Activity_03cwn8x">
        <bpmn2:dataInput id="_Activity_03cwn8x_TaskTypeInput" drools:dtype="String" name="TaskType" />
        <bpmn2:dataInput id="_Activity_03cwn8x_subjectInput" drools:dtype="String" name="subject" />
        <bpmn2:dataInput id="_Activity_03cwn8x_bodyInput" drools:dtype="String" name="body" />
        <bpmn2:dataInput id="_Activity_03cwn8x_messageInput" drools:dtype="String" name="message" />
        <bpmn2:inputSet id="inputSet_Activity_03cwn8x">
          <bpmn2:dataInputRefs>_Activity_03cwn8x_TaskTypeInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Activity_03cwn8x_subjectInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Activity_03cwn8x_bodyInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Activity_03cwn8x_messageInput</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="outputSet_Activity_03cwn8x">
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation id="dia_Activity_03cwn8x_TaskType">
        <bpmn2:targetRef>_Activity_03cwn8x_TaskTypeInput</bpmn2:targetRef>
        <bpmn2:assignment id="assign_Activity_03cwn8x_TaskType">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">send-user-message</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_Activity_03cwn8x_TaskTypeInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia_Activity_03cwn8x_subject">
        <bpmn2:targetRef>_Activity_03cwn8x_subjectInput</bpmn2:targetRef>
        <bpmn2:assignment id="assign_Activity_03cwn8x_subject">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">#{&quot;You&apos;ve successfully deleted your document of document type:&quot; + document_type + &quot; Since this is a KYC document you will be identified as unverified to other users.  Uploading a new &quot; + document_type + &quot;will help to fix this issue.&quot;}</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_Activity_03cwn8x_subjectInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia_Activity_03cwn8x_body">
        <bpmn2:targetRef>_Activity_03cwn8x_bodyInput</bpmn2:targetRef>
        <bpmn2:assignment id="assign_Activity_03cwn8x_body">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">#{&quot;The removal of your &quot; + document_type + &quot; document was successfully completed.&quot;}</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_Activity_03cwn8x_bodyInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia_Activity_03cwn8x_message">
        <bpmn2:targetRef>_Activity_03cwn8x_messageInput</bpmn2:targetRef>
        <bpmn2:assignment id="assign_Activity_03cwn8x_message">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">#{&quot;Your document type:&quot; + document_type +&quot; was successfully removed&quot;}</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_Activity_03cwn8x_messageInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
    </bpmn2:task>

    <bpmn2:endEvent id="Event_0hqz2ai">
      <bpmn2:incoming>Flow_1asrulk</bpmn2:incoming>
    </bpmn2:endEvent>

    <bpmn2:sequenceFlow id="Flow_1rjds41" sourceRef="StartEvent_1" targetRef="Activity_0qxttjd" />
    <bpmn2:sequenceFlow id="Flow_1asrulk" sourceRef="Activity_03cwn8x" targetRef="Event_0hqz2ai" />
    <bpmn2:sequenceFlow id="Flow_0luoemx" sourceRef="Activity_0qxttjd" targetRef="Activity_1pcujrf" />
    <bpmn2:sequenceFlow id="Flow_1vsk09w" sourceRef="Activity_1pcujrf" targetRef="Activity_11jd6d5" />
    <bpmn2:sequenceFlow id="Flow_0whyk7g" sourceRef="Activity_11jd6d5" targetRef="Activity_03cwn8x" />

  </bpmn2:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="delete-kyc-document">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="182" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0qxttjd_di" bpmnElement="Activity_0qxttjd">
        <dc:Bounds x="260" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1pcujrf_di" bpmnElement="Activity_1pcujrf">
        <dc:Bounds x="410" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_11jd6d5_di" bpmnElement="Activity_11jd6d5">
        <dc:Bounds x="550" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_01mlggc" bpmnElement="Activity_03cwn8x">
        <dc:Bounds x="700" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0hqz2ai_di" bpmnElement="Event_0hqz2ai">
        <dc:Bounds x="852" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1rjds41_di" bpmnElement="Flow_1rjds41">
        <di:waypoint x="218" y="120" />
        <di:waypoint x="260" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0luoemx_di" bpmnElement="Flow_0luoemx">
        <di:waypoint x="360" y="120" />
        <di:waypoint x="410" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1vsk09w_di" bpmnElement="Flow_1vsk09w">
        <di:waypoint x="510" y="120" />
        <di:waypoint x="550" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0whyk7g_di" bpmnElement="Flow_0whyk7g">
        <di:waypoint x="650" y="120" />
        <di:waypoint x="700" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1asrulk_di" bpmnElement="Flow_1asrulk">
        <di:waypoint x="800" y="120" />
        <di:waypoint x="852" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn2:definitions>
