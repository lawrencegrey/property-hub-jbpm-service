        <bpmn2:targetRef>_Activity_15839ek_TaskTypeInput</bpmn2:targetRef>
        <bpmn2:assignment id="assign_Activity_15839ek_TaskType">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">notify-admins</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_Activity_15839ek_TaskTypeInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia_Activity_15839ek_body">
        <bpmn2:targetRef>_Activity_15839ek_bodyInput</bpmn2:targetRef>
        <bpmn2:assignment id="assign_Activity_15839ek_body">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">#{"Just notifying you that you have a new manual document verification request from " + first_name +" " + last_name +"."}</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_Activity_15839ek_bodyInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia_Activity_15839ek_subject">
        <bpmn2:targetRef>_Activity_15839ek_subjectInput</bpmn2:targetRef>
        <bpmn2:assignment id="assign_Activity_15839ek_subject">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">Manual Document Verification (KYC)</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_Activity_15839ek_subjectInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
    </bpmn2:task>
    <bpmn2:task id="Activity_1ti0w73" name="Send user verification failure message" drools:taskName="send-user-message">
