          <bpmn2:dataInputRefs>_Activity_0zrx6bx_person_idInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Activity_0zrx6bx_engagement_idInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Activity_0zrx6bx_person_typeInput</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
