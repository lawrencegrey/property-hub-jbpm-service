          <bpmn2:from xsi:type="bpmn2:tFormalExpression">send-user-message</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_Activity_02m143y_TaskTypeInput</bpmn2:to>
