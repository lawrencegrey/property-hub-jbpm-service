        <bpmn2:targetRef>_Activity_02m143y_subjectInput</bpmn2:targetRef>
        <bpmn2:assignment id="assign_Activity_02m143y_subject">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">#{transaction_type + " application was accepted for " + property_name}</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_Activity_02m143y_subjectInput</bpmn2:to>
        </bpmn2:assignment>
