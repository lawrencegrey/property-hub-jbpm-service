        <bpmn2:targetRef>_Activity_0zrx6bx_TaskTypeInput</bpmn2:targetRef>
        <bpmn2:assignment id="assign_Activity_0zrx6bx_TaskType">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">add-engagement-party</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_Activity_0zrx6bx_TaskTypeInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
