        <bpmn2:sourceRef>property_id</bpmn2:sourceRef>
        <bpmn2:targetRef>_Activity_0zrx6bx_property_idInput</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia_Activity_0zrx6bx_person_id">
        <bpmn2:sourceRef>person_id</bpmn2:sourceRef>
        <bpmn2:targetRef>_Activity_0zrx6bx_person_idInput</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia_Activity_0zrx6bx_engagement_id">
        <bpmn2:sourceRef>engagement_id</bpmn2:sourceRef>
        <bpmn2:targetRef>_Activity_0zrx6bx_engagement_idInput</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia_Activity_0zrx6bx_person_type">
        <bpmn2:targetRef>_Activity_0zrx6bx_person_typeInput</bpmn2:targetRef>
