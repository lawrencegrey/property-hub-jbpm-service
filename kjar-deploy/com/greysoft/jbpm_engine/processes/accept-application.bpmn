      <bpmn2:incoming>Flow_0amxioo</bpmn2:incoming>
      <bpmn2:outgoing>Flow_0gz5b2l</bpmn2:outgoing>
      <bpmn2:ioSpecification id="ioSpec_Activity_0zrx6bx">
