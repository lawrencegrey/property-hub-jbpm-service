      <bpmn2:dataInputAssociation id="dia_Activity_02m143y_body">
        <bpmn2:targetRef>_Activity_02m143y_bodyInput</bpmn2:targetRef>
        <bpmn2:assignment id="assign_Activity_02m143y_body">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">#{"Your " + transaction_type + " application for " + property_name + " was accepted by the property lister. An engagement is now active and can be viewed on PropertyPlatformJMÂ®."}</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_Activity_02m143y_bodyInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
