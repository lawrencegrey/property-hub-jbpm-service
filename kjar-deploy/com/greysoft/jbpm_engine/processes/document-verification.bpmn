    <bpmn2:sequenceFlow id="Flow_169ois6" sourceRef="Gateway_036eyke" targetRef="Gateway_0success_merge">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">return !java.util.Arrays.asList("NATIONAL_ID", "DRIVERS_LICENSE", "TRN", "VOTER_ID", "BIRTH_CERTIFICATE", "PATH_CARD", "NIS_CARD", "WORK_ID", "STUDENT_ID").contains(document_type);</bpmn2:conditionExpression>
