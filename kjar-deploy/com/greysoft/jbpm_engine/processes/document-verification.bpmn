    <bpmn2:sequenceFlow id="Flow_1qxljm7" sourceRef="Gateway_036eyke" targetRef="Activity_1pcujrf">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">return java.util.Arrays.asList("NATIONAL_ID", "PASSPORT", "DRIVERS_LICENSE", "TAX_CARD", "VOTER_ID", "BIRTH_CERTIFICATE", "PATH_CARD", "NIS_CARD", "WORK_ID", "STUDENT_ID", "FOREIGN_PASSPORT", "PROOF_OF_ADDRESS", "PASSPORT_PIC").contains(document_type);</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_0u75rk0" sourceRef="Gateway_036eyke" targetRef="Activity_0opfdhp">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">return "PROOF_OF_PROFESSIONAL_ADDRESS".equals(document_type);</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
