<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:drools="http://www.jboss.org/drools"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_0j1nwjd"
                   targetNamespace="http://www.jboss.org/drools"
                   expressionLanguage="http://www.mvel.org/2.0"
                   typeLanguage="http://www.java.com/javaTypes"
                   xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd">

  <!-- ============ Item Definitions (process variables) ============ -->
  <bpmn2:itemDefinition id="_bodyItem" structureRef="String" />
  <bpmn2:itemDefinition id="_document_idItem" structureRef="String" />
  <bpmn2:itemDefinition id="_document_typeItem" structureRef="String" />
  <bpmn2:itemDefinition id="_engagement_idItem" structureRef="String" />
  <bpmn2:itemDefinition id="_notify_typeItem" structureRef="String" />
  <bpmn2:itemDefinition id="_party_typeItem" structureRef="String" />
  <bpmn2:itemDefinition id="_subjectItem" structureRef="String" />

  <!-- ============ Process ============ -->
  <bpmn2:process id="notify-engagement-parties-on-docs" name="notify-engagement-parties-on-docs" isExecutable="true"
                 drools:packageName="com.greysoft.jbpm_engine.processes">

    <!-- Process-level variables -->
    <bpmn2:property id="body" itemSubjectRef="_bodyItem" name="body" />
    <bpmn2:property id="document_id" itemSubjectRef="_document_idItem" name="document_id" />
    <bpmn2:property id="document_type" itemSubjectRef="_document_typeItem" name="document_type" />
    <bpmn2:property id="engagement_id" itemSubjectRef="_engagement_idItem" name="engagement_id" />
    <bpmn2:property id="notify_type" itemSubjectRef="_notify_typeItem" name="notify_type" />
    <bpmn2:property id="party_type" itemSubjectRef="_party_typeItem" name="party_type" />
    <bpmn2:property id="subject" itemSubjectRef="_subjectItem" name="subject" />

    <bpmn2:startEvent id="StartEvent_1">
      <bpmn2:outgoing>Flow_1ezvtqv</bpmn2:outgoing>
    </bpmn2:startEvent>

    <bpmn2:userTask id="Activity_02hpqs5" name="Get engagement info">
      <bpmn2:incoming>Flow_1ezvtqv</bpmn2:incoming>
      <bpmn2:outgoing>Flow_0cmr9qp</bpmn2:outgoing>
      <bpmn2:potentialOwner id="po_Activity_02hpqs5">
        <bpmn2:resourceAssignmentExpression id="rae_Activity_02hpqs5">
          <bpmn2:formalExpression>wbadmin</bpmn2:formalExpression>
        </bpmn2:resourceAssignmentExpression>
      </bpmn2:potentialOwner>
      <bpmn2:ioSpecification id="ioSpec_Activity_02hpqs5">
        <bpmn2:dataOutput id="_Activity_02hpqs5_engagement_idOutput" name="engagement_id" />
        <bpmn2:dataOutput id="_Activity_02hpqs5_document_idOutput" name="document_id" />
        <bpmn2:dataOutput id="_Activity_02hpqs5_document_typeOutput" name="document_type" />
        <bpmn2:dataOutput id="_Activity_02hpqs5_notify_typeOutput" name="notify_type" />
        <bpmn2:dataOutput id="_Activity_02hpqs5_party_typeOutput" name="party_type" />
        <bpmn2:inputSet id="inputSet_Activity_02hpqs5" />
        <bpmn2:outputSet id="outputSet_Activity_02hpqs5">
          <bpmn2:dataOutputRefs>_Activity_02hpqs5_engagement_idOutput</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_Activity_02hpqs5_document_idOutput</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_Activity_02hpqs5_document_typeOutput</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_Activity_02hpqs5_notify_typeOutput</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_Activity_02hpqs5_party_typeOutput</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataOutputAssociation id="doa_Activity_02hpqs5_engagement_id">
        <bpmn2:sourceRef>_Activity_02hpqs5_engagement_idOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>engagement_id</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation id="doa_Activity_02hpqs5_document_id">
        <bpmn2:sourceRef>_Activity_02hpqs5_document_idOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>document_id</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation id="doa_Activity_02hpqs5_document_type">
        <bpmn2:sourceRef>_Activity_02hpqs5_document_typeOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>document_type</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation id="doa_Activity_02hpqs5_notify_type">
        <bpmn2:sourceRef>_Activity_02hpqs5_notify_typeOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>notify_type</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation id="doa_Activity_02hpqs5_party_type">
        <bpmn2:sourceRef>_Activity_02hpqs5_party_typeOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>party_type</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:userTask>

    <bpmn2:task id="Activity_08qui52" name="Get  &amp; notifiy participants"
               drools:taskName="notify-participants">
      <bpmn2:incoming>Flow_0hce6qg</bpmn2:incoming>
      <bpmn2:outgoing>Flow_1u00919</bpmn2:outgoing>
      <bpmn2:ioSpecification id="ioSpec_Activity_08qui52">
        <bpmn2:dataInput id="_Activity_08qui52_TaskTypeInput" drools:dtype="String" name="TaskType" />
        <bpmn2:dataInput id="_Activity_08qui52_engagement_idInput" drools:dtype="String" name="engagement_id" />
        <bpmn2:dataInput id="_Activity_08qui52_subjectInput" drools:dtype="String" name="subject" />
        <bpmn2:dataInput id="_Activity_08qui52_bodyInput" drools:dtype="String" name="body" />
        <bpmn2:inputSet id="inputSet_Activity_08qui52">
          <bpmn2:dataInputRefs>_Activity_08qui52_TaskTypeInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Activity_08qui52_engagement_idInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Activity_08qui52_subjectInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Activity_08qui52_bodyInput</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="outputSet_Activity_08qui52">
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation id="dia_Activity_08qui52_TaskType">
        <bpmn2:targetRef>_Activity_08qui52_TaskTypeInput</bpmn2:targetRef>
        <bpmn2:assignment id="assign_Activity_08qui52_TaskType">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">notify-participants</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_Activity_08qui52_TaskTypeInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia_Activity_08qui52_engagement_id">
        <bpmn2:sourceRef>engagement_id</bpmn2:sourceRef>
        <bpmn2:targetRef>_Activity_08qui52_engagement_idInput</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia_Activity_08qui52_subject">
        <bpmn2:sourceRef>subject</bpmn2:sourceRef>
        <bpmn2:targetRef>_Activity_08qui52_subjectInput</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia_Activity_08qui52_body">
        <bpmn2:sourceRef>body</bpmn2:sourceRef>
        <bpmn2:targetRef>_Activity_08qui52_bodyInput</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
    </bpmn2:task>

    <bpmn2:scriptTask id="Activity_00cywga" name="Populate subject" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>Flow_0cmr9qp</bpmn2:incoming>
      <bpmn2:outgoing>Flow_1ugduao</bpmn2:outgoing>
      <bpmn2:script>kcontext.setVariable("subject", &quot;New &quot; + document_type + &quot; uploaded by &quot; + party_type);</bpmn2:script>
    </bpmn2:scriptTask>

    <bpmn2:scriptTask id="Activity_0hz0fbf" name="Populate body" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>Flow_1ugduao</bpmn2:incoming>
      <bpmn2:outgoing>Flow_0hce6qg</bpmn2:outgoing>
      <bpmn2:script>kcontext.setVariable("body", &quot;A &quot; + document_type + &quot; document has been uploaded by a/an &quot; + party_type + &quot; to the engagement.  You may review it at your earliest convenience.&quot;);</bpmn2:script>
    </bpmn2:scriptTask>

    <bpmn2:endEvent id="Event_19vwwjp">
      <bpmn2:incoming>Flow_1u00919</bpmn2:incoming>
    </bpmn2:endEvent>

    <bpmn2:sequenceFlow id="Flow_1ezvtqv" sourceRef="StartEvent_1" targetRef="Activity_02hpqs5" />
    <bpmn2:sequenceFlow id="Flow_1u00919" sourceRef="Activity_08qui52" targetRef="Event_19vwwjp" />
    <bpmn2:sequenceFlow id="Flow_0cmr9qp" sourceRef="Activity_02hpqs5" targetRef="Activity_00cywga" />
    <bpmn2:sequenceFlow id="Flow_1ugduao" sourceRef="Activity_00cywga" targetRef="Activity_0hz0fbf" />
    <bpmn2:sequenceFlow id="Flow_0hce6qg" sourceRef="Activity_0hz0fbf" targetRef="Activity_08qui52" />

  </bpmn2:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="notify-engagement-parties-on-docs">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="182" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_02hpqs5_di" bpmnElement="Activity_02hpqs5">
        <dc:Bounds x="270" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_00cywga_di" bpmnElement="Activity_00cywga">
        <dc:Bounds x="410" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0hz0fbf_di" bpmnElement="Activity_0hz0fbf">
        <dc:Bounds x="570" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_08qui52_di" bpmnElement="Activity_08qui52">
        <dc:Bounds x="740" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_19vwwjp_di" bpmnElement="Event_19vwwjp">
        <dc:Bounds x="902" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1ezvtqv_di" bpmnElement="Flow_1ezvtqv">
        <di:waypoint x="218" y="120" />
        <di:waypoint x="270" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1u00919_di" bpmnElement="Flow_1u00919">
        <di:waypoint x="840" y="120" />
        <di:waypoint x="902" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0cmr9qp_di" bpmnElement="Flow_0cmr9qp">
        <di:waypoint x="370" y="120" />
        <di:waypoint x="410" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1ugduao_di" bpmnElement="Flow_1ugduao">
        <di:waypoint x="510" y="120" />
        <di:waypoint x="570" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0hce6qg_di" bpmnElement="Flow_0hce6qg">
        <di:waypoint x="670" y="120" />
        <di:waypoint x="740" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn2:definitions>
