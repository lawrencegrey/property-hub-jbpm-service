<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:drools="http://www.jboss.org/drools"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_makeOffer"
                   targetNamespace="http://www.jboss.org/drools"
                   expressionLanguage="http://www.mvel.org/2.0"
                   typeLanguage="http://www.java.com/javaTypes"
                   xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd">

  <!-- ============ Item Definitions (process variables) ============ -->
  <bpmn2:itemDefinition id="_property_idItem" structureRef="String" />
  <bpmn2:itemDefinition id="_person_idItem" structureRef="String" />
  <bpmn2:itemDefinition id="_property_nameItem" structureRef="String" />
  <bpmn2:itemDefinition id="_offer_amountItem" structureRef="String" />
  <bpmn2:itemDefinition id="_currencyItem" structureRef="String" />
  <bpmn2:itemDefinition id="_emailItem" structureRef="String" />
  <bpmn2:itemDefinition id="_mobile_numberItem" structureRef="String" />
  <bpmn2:itemDefinition id="_device_tokenItem" structureRef="String" />
  <bpmn2:itemDefinition id="_subjectItem" structureRef="String" />
  <bpmn2:itemDefinition id="_bodyItem" structureRef="String" />
  <bpmn2:itemDefinition id="_successItem" structureRef="Boolean" />

  <!-- ============ Process ============ -->
  <bpmn2:process id="make-offer" name="make-offer" isExecutable="true"
                 drools:packageName="com.greysoft.jbpm_engine.processes">

    <!-- Process-level variables -->
    <bpmn2:property id="property_id" itemSubjectRef="_property_idItem" name="property_id" />
    <bpmn2:property id="person_id" itemSubjectRef="_person_idItem" name="person_id" />
    <bpmn2:property id="property_name" itemSubjectRef="_property_nameItem" name="property_name" />
    <bpmn2:property id="offer_amount" itemSubjectRef="_offer_amountItem" name="offer_amount" />
    <bpmn2:property id="currency" itemSubjectRef="_currencyItem" name="currency" />
    <bpmn2:property id="email" itemSubjectRef="_emailItem" name="email" />
    <bpmn2:property id="mobile_number" itemSubjectRef="_mobile_numberItem" name="mobile_number" />
    <bpmn2:property id="device_token" itemSubjectRef="_device_tokenItem" name="device_token" />
    <bpmn2:property id="subject" itemSubjectRef="_subjectItem" name="subject" />
    <bpmn2:property id="body" itemSubjectRef="_bodyItem" name="body" />

    <!-- ===== Start Event ===== -->
    <bpmn2:startEvent id="StartEvent_1" name="Start">
      <bpmn2:outgoing>Flow_06v4llo</bpmn2:outgoing>
    </bpmn2:startEvent>

    <!-- ===== User Task: Make Offer ===== -->
    <bpmn2:userTask id="Activity_1a3xz8p" name="Make offer">
      <bpmn2:extensionElements>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script></drools:script>
        </drools:onEntry-script>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_06v4llo</bpmn2:incoming>
      <bpmn2:outgoing>Flow_02a9xtw</bpmn2:outgoing>
      <bpmn2:potentialOwner id="po_Activity_1a3xz8p">
        <bpmn2:resourceAssignmentExpression id="rae_Activity_1a3xz8p">
          <bpmn2:formalExpression>wbadmin</bpmn2:formalExpression>
        </bpmn2:resourceAssignmentExpression>
      </bpmn2:potentialOwner>
      <bpmn2:ioSpecification id="ioSpec_makeOffer">
        <bpmn2:dataOutput id="_Activity_1a3xz8p_property_idOutput" name="property_id" />
        <bpmn2:dataOutput id="_Activity_1a3xz8p_person_idOutput" name="person_id" />
        <bpmn2:dataOutput id="_Activity_1a3xz8p_property_nameOutput" name="property_name" />
        <bpmn2:dataOutput id="_Activity_1a3xz8p_offer_amountOutput" name="offer_amount" />
        <bpmn2:dataOutput id="_Activity_1a3xz8p_currencyOutput" name="currency" />
        <bpmn2:inputSet id="inputSet_makeOffer" />
        <bpmn2:outputSet id="outputSet_makeOffer">
          <bpmn2:dataOutputRefs>_Activity_1a3xz8p_property_idOutput</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_Activity_1a3xz8p_person_idOutput</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_Activity_1a3xz8p_property_nameOutput</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_Activity_1a3xz8p_offer_amountOutput</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_Activity_1a3xz8p_currencyOutput</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataOutputAssociation id="doa_mo_propertyId">
        <bpmn2:sourceRef>_Activity_1a3xz8p_property_idOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>property_id</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation id="doa_mo_personId">
        <bpmn2:sourceRef>_Activity_1a3xz8p_person_idOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>person_id</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation id="doa_mo_propertyName">
        <bpmn2:sourceRef>_Activity_1a3xz8p_property_nameOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>property_name</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation id="doa_mo_offerAmount">
        <bpmn2:sourceRef>_Activity_1a3xz8p_offer_amountOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>offer_amount</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation id="doa_mo_currency">
        <bpmn2:sourceRef>_Activity_1a3xz8p_currencyOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>currency</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:userTask>

    <!-- ===== Service Task: Get Person Details (WIH: get-person-details) ===== -->
    <bpmn2:task id="Activity_0etwm1m" name="Get person details"
               drools:taskName="get-person-details">
      <bpmn2:incoming>Flow_02a9xtw</bpmn2:incoming>
      <bpmn2:outgoing>Flow_0o0duvf</bpmn2:outgoing>
      <bpmn2:ioSpecification id="ioSpec_getPersonDetails">
        <bpmn2:dataInput id="_Activity_0etwm1m_TaskTypeInput" drools:dtype="String" name="TaskType" />
        <bpmn2:dataInput id="_Activity_0etwm1m_person_idInput" drools:dtype="String" name="person_id" />
        <bpmn2:dataOutput id="_Activity_0etwm1m_emailOutput" drools:dtype="String" name="email" />
        <bpmn2:dataOutput id="_Activity_0etwm1m_mobile_numberOutput" drools:dtype="String" name="mobile_number" />
        <bpmn2:dataOutput id="_Activity_0etwm1m_device_tokenOutput" drools:dtype="String" name="device_token" />
        <bpmn2:dataOutput id="_Activity_0etwm1m_successOutput" drools:dtype="Boolean" name="success" />
        <bpmn2:inputSet id="inputSet_getPersonDetails">
          <bpmn2:dataInputRefs>_Activity_0etwm1m_TaskTypeInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Activity_0etwm1m_person_idInput</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="outputSet_getPersonDetails">
          <bpmn2:dataOutputRefs>_Activity_0etwm1m_emailOutput</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_Activity_0etwm1m_mobile_numberOutput</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_Activity_0etwm1m_device_tokenOutput</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_Activity_0etwm1m_successOutput</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <!-- Inputs: map process vars → task params -->
      <bpmn2:dataInputAssociation id="dia_gpd_taskType">
        <bpmn2:targetRef>_Activity_0etwm1m_TaskTypeInput</bpmn2:targetRef>
        <bpmn2:assignment id="assign_gpd_taskType">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">get-person-details</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_Activity_0etwm1m_TaskTypeInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia_gpd_personId">
        <bpmn2:sourceRef>person_id</bpmn2:sourceRef>
        <bpmn2:targetRef>_Activity_0etwm1m_person_idInput</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <!-- Outputs: task results → process vars -->
      <bpmn2:dataOutputAssociation id="doa_gpd_email">
        <bpmn2:sourceRef>_Activity_0etwm1m_emailOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>email</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation id="doa_gpd_mobile">
        <bpmn2:sourceRef>_Activity_0etwm1m_mobile_numberOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>mobile_number</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation id="doa_gpd_token">
        <bpmn2:sourceRef>_Activity_0etwm1m_device_tokenOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>device_token</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:task>

    <!-- ===== Service Task: Send Notification to Lister (WIH: send-user-message) ===== -->
    <bpmn2:task id="Activity_1il80t0" name="Send notification to lister"
               drools:taskName="send-user-message">
      <bpmn2:incoming>Flow_0o0duvf</bpmn2:incoming>
      <bpmn2:outgoing>Flow_173nn7o</bpmn2:outgoing>
      <bpmn2:ioSpecification id="ioSpec_sendNotification">
        <bpmn2:dataInput id="_Activity_1il80t0_TaskTypeInput" drools:dtype="String" name="TaskType" />
        <bpmn2:dataInput id="_Activity_1il80t0_emailInput" drools:dtype="String" name="email" />
        <bpmn2:dataInput id="_Activity_1il80t0_mobile_numberInput" drools:dtype="String" name="mobile_number" />
        <bpmn2:dataInput id="_Activity_1il80t0_device_tokenInput" drools:dtype="String" name="device_token" />
        <bpmn2:dataInput id="_Activity_1il80t0_subjectInput" drools:dtype="String" name="subject" />
        <bpmn2:dataInput id="_Activity_1il80t0_bodyInput" drools:dtype="String" name="body" />
        <bpmn2:inputSet id="inputSet_sendNotification">
          <bpmn2:dataInputRefs>_Activity_1il80t0_TaskTypeInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Activity_1il80t0_emailInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Activity_1il80t0_mobile_numberInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Activity_1il80t0_device_tokenInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Activity_1il80t0_subjectInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Activity_1il80t0_bodyInput</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="outputSet_sendNotification" />
      </bpmn2:ioSpecification>
      <!-- Inputs -->
      <bpmn2:dataInputAssociation id="dia_sn_taskType">
        <bpmn2:targetRef>_Activity_1il80t0_TaskTypeInput</bpmn2:targetRef>
        <bpmn2:assignment id="assign_sn_taskType">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">send-user-message</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_Activity_1il80t0_TaskTypeInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia_sn_email">
        <bpmn2:sourceRef>email</bpmn2:sourceRef>
        <bpmn2:targetRef>_Activity_1il80t0_emailInput</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia_sn_mobile">
        <bpmn2:sourceRef>mobile_number</bpmn2:sourceRef>
        <bpmn2:targetRef>_Activity_1il80t0_mobile_numberInput</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia_sn_token">
        <bpmn2:sourceRef>device_token</bpmn2:sourceRef>
        <bpmn2:targetRef>_Activity_1il80t0_device_tokenInput</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia_sn_subject">
        <bpmn2:sourceRef>subject</bpmn2:sourceRef>
        <bpmn2:targetRef>_Activity_1il80t0_subjectInput</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia_sn_body">
        <bpmn2:sourceRef>body</bpmn2:sourceRef>
        <bpmn2:targetRef>_Activity_1il80t0_bodyInput</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
    </bpmn2:task>

    <!-- ===== End Event ===== -->
    <bpmn2:endEvent id="Event_0xlt9el" name="End">
      <bpmn2:incoming>Flow_173nn7o</bpmn2:incoming>
    </bpmn2:endEvent>

    <!-- ===== Sequence Flows ===== -->
    <bpmn2:sequenceFlow id="Flow_06v4llo" sourceRef="StartEvent_1" targetRef="Activity_1a3xz8p" />
    <bpmn2:sequenceFlow id="Flow_02a9xtw" sourceRef="Activity_1a3xz8p" targetRef="Activity_0etwm1m" />
    <bpmn2:sequenceFlow id="Flow_0o0duvf" sourceRef="Activity_0etwm1m" targetRef="Activity_1il80t0" />
    <bpmn2:sequenceFlow id="Flow_173nn7o" sourceRef="Activity_1il80t0" targetRef="Event_0xlt9el" />
  </bpmn2:process>

  <!-- ============ Diagram ============ -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="make-offer">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="182" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1a3xz8p_di" bpmnElement="Activity_1a3xz8p">
        <dc:Bounds x="260" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0etwm1m_di" bpmnElement="Activity_0etwm1m">
        <dc:Bounds x="410" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1il80t0_di" bpmnElement="Activity_1il80t0">
        <dc:Bounds x="560" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0xlt9el_di" bpmnElement="Event_0xlt9el">
        <dc:Bounds x="712" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_06v4llo_di" bpmnElement="Flow_06v4llo">
        <di:waypoint x="218" y="120" />
        <di:waypoint x="260" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02a9xtw_di" bpmnElement="Flow_02a9xtw">
        <di:waypoint x="360" y="120" />
        <di:waypoint x="410" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0o0duvf_di" bpmnElement="Flow_0o0duvf">
        <di:waypoint x="510" y="120" />
        <di:waypoint x="560" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_173nn7o_di" bpmnElement="Flow_173nn7o">
        <di:waypoint x="660" y="120" />
        <di:waypoint x="712" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>
