        <bpmn2:targetRef>_Activity_02m143y_bodyInput</bpmn2:targetRef>
        <bpmn2:assignment id="assign_Activity_02m143y_body">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">#{"Your offer of "+ currency +" " + offer_amount + " for " + property_name + " was accepted by property lister.  An engagement is now active and can be viewed on PropertyPlatformJMÂ®."}</bpmn2:from>
