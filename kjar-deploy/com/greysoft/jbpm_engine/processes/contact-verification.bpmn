    <bpmn2:scriptTask id="Activity_1576vzf" name="Validate confirmation code" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>Flow_1m1gfqx</bpmn2:incoming>
      <bpmn2:outgoing>Flow_1o49vld</bpmn2:outgoing>
      <bpmn2:script>kcontext.setVariable("verificationPassed", confirmation_code.equals(confirmation_code_entered));</bpmn2:script>
    </bpmn2:scriptTask>
