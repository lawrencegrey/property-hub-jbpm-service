          <bpmn2:from xsi:type="bpmn2:tFormalExpression">#{"Your PropertyPlatformJMÃ‚Â® confirmation code is: " + confirmation_code + ". Please use this code to verify your email address. The code will expire in a few minutes."}</bpmn2:from>
