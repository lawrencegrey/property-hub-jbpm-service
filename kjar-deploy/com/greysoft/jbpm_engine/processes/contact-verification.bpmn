      <bpmn2:dataInputAssociation id="dia_Activity_1d8tzc4_message">
        <bpmn2:targetRef>_Activity_1d8tzc4_messageInput</bpmn2:targetRef>
        <bpmn2:assignment id="assign_Activity_1d8tzc4_message">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">#{"Your PropertyPlatformJMÃ‚Â® verification code is " + confirmation_code + ". Please enter this code to confirm your mobile number. It will expire in a few minutes."}</bpmn2:from>
