    <bpmn2:task id="Activity_1d8tzc4" name="Send  confirmation code to mobile" drools:taskName="send-sms-notification">
      <bpmn2:incoming>Flow_00zv10q</bpmn2:incoming>
      <bpmn2:outgoing>Flow_1nmcs3s</bpmn2:outgoing>
      <bpmn2:ioSpecification id="ioSpec_Activity_1d8tzc4">
        <bpmn2:dataInput id="_Activity_1d8tzc4_TaskTypeInput" drools:dtype="String" name="TaskType" />
        <bpmn2:dataInput id="_Activity_1d8tzc4_messageInput" drools:dtype="String" name="message" />
        <bpmn2:dataInput id="_Activity_1d8tzc4_mobile_numberInput" drools:dtype="String" name="mobile_number" />
